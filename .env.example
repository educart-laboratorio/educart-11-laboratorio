# Supabase (Exemplo de Configuração)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente apos homologacao da tabela, bucket e RLS em PROD.
NEXT_PUBLIC_EDUCART_PROPOSTAS_DOCENTES_APROVADAS=false

# Portal oficial 1.1: habilitar APENAS no deploy final aprovado.
# Sem 'required', a portaria oficial nega todas as rotas administrativas.
# Isto NAO altera a EducART 1.0 publicada.
EDUCART_OFFICIAL_11_MODE=off
